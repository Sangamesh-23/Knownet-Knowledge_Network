
# ==========================================
# KNOWNET - Git Ignore Configuration
# ==========================================

# Files already present in the GitHub repository
/README.md
/PROJECT_OVERVIEW.md

# ---------- Frontend: React / Vite ----------
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/

# ---------- Backend: Python / FastAPI ----------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- Python Virtual Environments ----------
.venv/
venv/
env/
ENV/
backend/.venv/
backend/venv/

# ---------- Environment Variables & Secrets ----------
.env
.env.*
!.env.example

frontend/.env
frontend/.env.*
!frontend/.env.example

backend/.env
backend/.env.*
!backend/.env.example

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---------- Runtime Recordings ----------
# Ignore generated session recordings
backend/recordings/*
!backend/recordings/.gitkeep

# ---------- Uploaded Resources ----------
# Ignore runtime-uploaded files; retain the folder placeholder
backend/resources/*
!backend/resources/.gitkeep

# ---------- Local Database & Backup Files ----------
*.sql
*.sqlite
*.sqlite3
*.db
*.bak
*.dump

# ---------- IDE & Editor Files ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- Operating System Files ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Build & Temporary Files ----------
tmp/
temp/
.cache/
*.tmp
*.temp
